diff --git a/compiler/base/hierarchy_layout.py b/compiler/base/hierarchy_layout.py
index 4d8eb91..d4d4b14 100644
--- a/compiler/base/hierarchy_layout.py
+++ b/compiler/base/hierarchy_layout.py
@@ -2197,6 +2197,18 @@ class layout():
         # Add the moat
         self.add_path("nwell", [ll, lr, ur, ul, ll - vector(0, 0.5 * self.nwell_width)])
 
+        # rudr_sram patch (TT SKY130): sky130 rule nwell.5a needs the nwell over the dnwell edge to extend
+        # >= 0.4 um outside and >= 1.03 um inside. The moat path above is only nwell_width wide, centred on
+        # the edge. Add a band 0.45 um outside / 1.08 um inside the dnwell edge (0.05 um margin each).
+        o = 0.45
+        i = 1.08
+        w = ur.x - ll.x
+        h = ur.y - ll.y
+        self.add_rect("nwell", offset=vector(ll.x - o, ll.y - o), width=w + 2 * o, height=o + i)
+        self.add_rect("nwell", offset=vector(ll.x - o, ur.y - i), width=w + 2 * o, height=o + i)
+        self.add_rect("nwell", offset=vector(ll.x - o, ll.y - o), width=o + i, height=h + 2 * o)
+        self.add_rect("nwell", offset=vector(ur.x - i, ll.y - o), width=o + i, height=h + 2 * o)
+
         # Add the taps
         layer_stack = self.active_stack
         tap_spacing = 2
